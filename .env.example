# Razorpay test-mode credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_test_secret

# Google Gemini API key — used for intelligent root-cause diagnosis & localized conversational recovery copy.
# App runs fine WITHOUT this (falls back seamlessly to deterministic rule-based
# engine) so judges can run it with zero setup.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend & Database & Security
DATABASE_URL=sqlite:///./recovery.db
APP_ENV=development
PORT=8000
ADMIN_API_KEY=

# Dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
